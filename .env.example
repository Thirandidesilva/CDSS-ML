# Copy to .env (gitignored) and fill in real values. Never commit .env.

# Supabase Postgres connection string. Use the direct connection (port 5432) for
# Alembic migrations; swap to the Supavisor/PgBouncer pooler (port 6543, transaction
# mode) only if the app is deployed somewhere with many short-lived connections.
DATABASE_URL=postgresql+psycopg://postgres:[password]@[project-ref].supabase.co:5432/postgres?sslmode=require

JWT_SECRET=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
RESET_TOKEN_EXPIRE_MINUTES=15

# Resend's HTTP API — used to email OTP codes and, once verified, the username/reset
# flow. For real users at arbitrary addresses, EMAIL_FROM_ADDRESS must be on a domain
# verified in this Resend account (Dashboard -> Domains -> add your domain's SPF/DKIM
# records). Until then, use the sandbox sender below — it can only deliver to the
# email address this Resend account itself was signed up with.
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM_ADDRESS=onboarding@resend.dev

OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
